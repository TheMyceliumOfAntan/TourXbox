<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TourXbox.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TourXbox"
    Title="TourXbox OSD">

    <Grid x:Name="Root" Background="#F2161616" Padding="18,10,18,12">
        <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="InputText" Text="" FontSize="11" Foreground="#8CFFFFFF" />
            <TextBlock x:Name="ActionText" Text="" FontSize="24" FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Window>
