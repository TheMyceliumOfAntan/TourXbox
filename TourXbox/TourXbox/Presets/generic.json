{
  "name": "通用（手动切换）",
  "processes": [],
  "bindings": {
    "LX": {
      "mode": "tick",
      "positive": "]",
      "negative": "[",
      "speed": 13,
      "note": "画笔大小"
    },
    "LY": {
      "mode": "tick",
      "positive": "WheelUp",
      "negative": "WheelDown",
      "speed": 14,
      "note": "缩放 / 滚动"
    },
    "DPadLeft": {
      "mode": "tap",
      "action": ",",
      "note": "上一笔刷预设"
    },
    "DPadRight": {
      "mode": "tap",
      "action": ".",
      "note": "下一笔刷预设"
    },
    "DPadUp": {
      "mode": "tap",
      "action": "Alt+]",
      "note": "上一图层"
    },
    "DPadDown": {
      "mode": "tap",
      "action": "Alt+[",
      "note": "下一图层"
    },
    "View": {
      "mode": "tap",
      "action": "Ctrl+Z",
      "note": "撤销"
    },
    "Menu": {
      "mode": "tap",
      "action": "Ctrl+Shift+Z",
      "note": "重做"
    },
    "A": {
      "mode": "tap",
      "action": "B",
      "note": "画笔"
    },
    "B": {
      "mode": "tap",
      "action": "E",
      "note": "橡皮"
    },
    "X": {
      "mode": "tap",
      "action": "I",
      "note": "吸管"
    },
    "Y": {
      "mode": "tap",
      "action": "Ctrl+Shift+N",
      "note": "新建图层"
    },
    "L3+PAN": {
      "mode": "drag",
      "modifier": "Space",
      "mouseButton": "MouseLeft",
      "note": "按住 L3 时左摇杆平移画布",
      "cursorRadius": 600,
      "wrap": true
    },
    "R3": {
      "mode": "tap",
      "action": "Ctrl+0",
      "note": "适合屏幕"
    },
    "RB+RY": {
      "mode": "tick",
      "positive": "Shift+]",
      "negative": "Shift+[",
      "note": "画笔硬度"
    },
    "RB+RX": {
      "mode": "tick",
      "positive": "]",
      "negative": "[",
      "speed": 22,
      "note": "画笔大小（粗调）"
    },
    "RX": {
      "mode": "tick",
      "positive": "Shift+WheelUp",
      "negative": "Shift+WheelDown",
      "speed": 15,
      "note": "画布左右滚动"
    },
    "RY": {
      "mode": "tick",
      "positive": "WheelUp",
      "negative": "WheelDown",
      "speed": 15,
      "note": "画布上下滚动"
    }
  }
}
