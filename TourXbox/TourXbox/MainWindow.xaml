<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TourXbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TourXbox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TourXbox">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="20,14,20,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶栏 ===== -->
        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="TourXbox" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="#C4423B" VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionText" Text="未连接手柄" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="PausedBadge" Text="已暂停" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="使用方法" Click="Help_Click" Padding="12,6" />
                <ComboBox x:Name="ProfileCombo" Width="230" VerticalAlignment="Center"
                          SelectionChanged="ProfileCombo_SelectionChanged" />
            </StackPanel>

            <ToggleButton x:Name="PauseToggle" Grid.Column="3" VerticalAlignment="Center"
                          Click="PauseToggle_Click" Padding="14,6">
                <TextBlock x:Name="PauseToggleText" Text="暂停映射" />
            </ToggleButton>
        </Grid>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 手柄示意图 -->
            <Border Grid.Column="0" Width="392" CornerRadius="16" Padding="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid Width="380" Height="312">

                    <!-- 机身 -->
                    <Border Margin="26,46,26,26" CornerRadius="64"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" />

                    <!-- 扳机 LT / RT（背面，画图时基本按不到） -->
                    <Border x:Name="TriggerLt" Width="52" Height="10" CornerRadius="5" Opacity="0.22"
                            Background="#8A8A8A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,8,0,0" />
                    <Border x:Name="TriggerRt" Width="52" Height="10" CornerRadius="5" Opacity="0.22"
                            Background="#8A8A8A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,34,0" />

                    <!-- 肩键 LB / RB -->
                    <Border x:Name="ShoulderLb" Width="78" Height="16" CornerRadius="8" Opacity="0.4"
                            Background="#8C9AA8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="42,24,0,0" />
                    <Border x:Name="ShoulderRb" Width="78" Height="16" CornerRadius="8" Opacity="0.4"
                            Background="#8C9AA8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,42,0" />

                    <!-- 左摇杆 -->
                    <Grid x:Name="StickLeftHost" Width="72" Height="72" Background="Transparent"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="62,84,0,0">
                        <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                        <Ellipse x:Name="StickLeftKnob" Width="40" Height="40" Fill="#8C9AA8" Opacity="0.55">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="StickLeftShift" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="L3" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="92,158,0,0" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <!-- 十字键 -->
                    <Grid x:Name="DpadHost" Width="78" Height="78" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="46,0,0,54">
                        <Rectangle x:Name="DpadUp" Width="24" Height="26" RadiusX="4" RadiusY="4" Opacity="0.35"
                                   Fill="#8C9AA8" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <Rectangle x:Name="DpadDown" Width="24" Height="26" RadiusX="4" RadiusY="4" Opacity="0.35"
                                   Fill="#8C9AA8" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        <Rectangle x:Name="DpadLeft" Width="26" Height="24" RadiusX="4" RadiusY="4" Opacity="0.35"
                                   Fill="#8C9AA8" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Rectangle x:Name="DpadRight" Width="26" Height="24" RadiusX="4" RadiusY="4" Opacity="0.35"
                                   Fill="#8C9AA8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 右摇杆 -->
                    <Grid x:Name="StickRightHost" Width="72" Height="72" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,56,60">
                        <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                        <Ellipse x:Name="StickRightKnob" Width="40" Height="40" Fill="#8C9AA8" Opacity="0.55">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="StickRightShift" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="R3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,84,34" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <!-- ABXY -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,44,0">
                        <Border x:Name="ButtonY" Width="30" Height="30" CornerRadius="15" Opacity="0.35"
                                Background="#E8B45A" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="Y" FontSize="12" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ButtonA" Width="30" Height="30" CornerRadius="15" Opacity="0.35"
                                Background="#6FBF73" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <TextBlock Text="A" FontSize="12" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ButtonX" Width="30" Height="30" CornerRadius="15" Opacity="0.35"
                                Background="#5B9BD5" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="X" FontSize="12" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ButtonB" Width="30" Height="30" CornerRadius="15" Opacity="0.35"
                                Background="#D9534F" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="B" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- View / Menu -->
                    <Border x:Name="ButtonView" Width="20" Height="20" CornerRadius="10" Opacity="0.35"
                            Background="#8C9AA8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-72,0,0,0">
                        <TextBlock Text="⧉" FontSize="10" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="ButtonMenu" Width="20" Height="20" CornerRadius="10" Opacity="0.35"
                            Background="#8C9AA8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="72,0,0,0">
                        <TextBlock Text="≡" FontSize="10" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 标注 -->
                </Grid>
            </Border>

            <!-- 映射表 -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MappingHeader" Text="映射" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="重新载入" Click="Reload_Click" Padding="12,4" />
                    <Button Grid.Column="2" Content="保存修改" Click="Save_Click" Padding="12,4" />
                </Grid>

                <ListView x:Name="BindingList" Grid.Row="1" SelectionMode="None"
                          ItemContainerTransitions="{x:Null}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BindingRow">
                            <Grid ColumnSpacing="10" Padding="0,4" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Bind InputLabel}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ModeLabel}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayText}" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Button Content="←" Tag="negative" Click="Capture_Click"
                                            Visibility="{x:Bind NegVisibility}" Padding="10,2" FontSize="12" />
                                    <Button Content="→" Tag="positive" Click="Capture_Click"
                                            Visibility="{x:Bind PosVisibility}" Padding="10,2" FontSize="12" />
                                    <Button Content="设置" Tag="action" Click="Capture_Click"
                                            Visibility="{x:Bind ActionVisibility}" Padding="12,2" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="18">
                    <CheckBox x:Name="OsdCheck" Content="显示动作提示" Click="OsdCheck_Click" />
                    <CheckBox x:Name="AxisLockCheck" Content="摇杆轴锁定" Click="AxisLockCheck_Click" />
                    <CheckBox x:Name="AutoStartCheck" Content="开机自启" Click="AutoStartCheck_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 底栏 ===== -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="等待手柄..." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FooterHint" Grid.Column="1" Text=""
                       FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
